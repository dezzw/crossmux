From 3891919c9ba6b8e923ca595eeaf5758c2bf4abd2 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sun, 4 Oct 2026 01:40:15 +0000
Subject: [PATCH] fix: stop forcing Confirm release on Function key-up

HalGPIO already merges logical edges from FunctionButtonGesture. Setting
BTN_CONFIRM released on every Function physical release caused an extra
Confirm edge on key-up (double-confirm in UI and premature menu open before
double-click Back could register).
---
 src/HalGPIO.cpp                        |  2 --
 tests/function_button_gesture_test.cpp | 10 ++++++++++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/HalGPIO.cpp b/src/HalGPIO.cpp
index 2e6de33..2490a8b 100644
--- a/src/HalGPIO.cpp
+++ b/src/HalGPIO.cpp
@@ -390,8 +390,6 @@ void onFaceButtonDown(int faceIndex) {
 void onFaceButtonUp(int faceIndex) {
   const auto button = static_cast<FaceButton>(faceIndex);
   faceGesture.onPhysicalReleased(button, SDL_GetTicks());
-  if (button == FaceButton::Function)
-    releasedThisFrame[HalGPIO::BTN_CONFIRM] = true;
   mergeGestureLogicalEdges();
 }
 
diff --git a/tests/function_button_gesture_test.cpp b/tests/function_button_gesture_test.cpp
index d7886c6..ef2a88c 100644
--- a/tests/function_button_gesture_test.cpp
+++ b/tests/function_button_gesture_test.cpp
@@ -8,6 +8,8 @@ int main() {
 
   gesture.onPhysicalPressed(FunctionButtonGesture::FaceButton::Function, now);
   gesture.onPhysicalReleased(FunctionButtonGesture::FaceButton::Function, now);
+  assert(!gesture.logicalReleased(HalGPIO::BTN_CONFIRM));
+  assert(!gesture.logicalReleased(HalGPIO::BTN_BACK));
   gesture.advance(now + FunctionButtonGesture::kDoubleClickWindowMs + 1);
   assert(gesture.logicalPressed(HalGPIO::BTN_CONFIRM));
   assert(!gesture.logicalPressed(HalGPIO::BTN_BACK));
@@ -27,6 +29,14 @@ int main() {
   gesture.onPhysicalReleased(FunctionButtonGesture::FaceButton::Left, now + 20);
   assert(gesture.logicalPressed(HalGPIO::BTN_UP));
 
+  gesture.reset();
+  now = 2500;
+  gesture.onPhysicalPressed(FunctionButtonGesture::FaceButton::Boot, now);
+  gesture.onPhysicalPressed(FunctionButtonGesture::FaceButton::Left, now);
+  gesture.onPhysicalReleased(FunctionButtonGesture::FaceButton::Left, now);
+  assert(gesture.logicalPressed(HalGPIO::BTN_UP));
+  assert(gesture.logicalReleased(HalGPIO::BTN_UP));
+
   gesture.reset();
   now = 3000;
   gesture.onPhysicalPressed(FunctionButtonGesture::FaceButton::Boot, now);
-- 
